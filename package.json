{
  "name": "buckwea",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rimraf --glob \"packages/*/dist\" \"apps/*/dist\" \"*.tsbuildinfo\" \"packages/*/*.tsbuildinfo\" \"apps/*/*.tsbuildinfo\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "report": "sh -c 'node apps/cli/dist/index.js analyze \"$1\" --html report.html && (explorer.exe report.html || true )' --"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
