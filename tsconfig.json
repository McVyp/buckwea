{
  "compilerOptions": {
    "target": "es2025",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2025"],
    "strict": true,
    "declaration": true,
    "composite": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "references": [
    { "path": "./packages/core" }
  ],
  "exclude": ["node_modules", "dist", "**/fixtures/**"]
}
